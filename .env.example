# Copy to .env and fill in ONE of the keys below (remove the leading "# "). Never commit .env.
# If both are set, Anthropic (Claude) is used.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY==sk-or

# Optional overrides
# OPERON_PROVIDER=anthropic          # or openrouter
# OPERON_MODEL=claude-opus-5-5       # or e.g. nvidia/nemotron-3-ultra-550b-a55b:free on OpenRouter
# OPERON_EFFORT=medium
# OPERON_VERIFIER_EFFORT=medium
# OPERON_SANDBOX_PORT=8765
# OPERON_BUSINESS_DATE=2026-10-12   # pin the sandbox's "today" for reproducible runs
